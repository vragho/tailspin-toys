---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
            aria-label="Filter games"
          >
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end">
              <fieldset class="flex-1">
                <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex min-w-56 flex-col gap-2">
                <label for="publisher-filter" class="text-sm font-semibold text-slate-200">Publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  data-testid="publisher-filter"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>

              <button
                type="reset"
                data-testid="reset-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                Clear filters
              </button>
            </div>
            <p class="mt-4 text-sm text-slate-400" data-testid="filter-status" role="status" aria-live="polite">
              Showing {games.length} {games.length === 1 ? 'game' : 'games'}
            </p>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (filterForm && status && filteredEmptyState) {
    const applyFilters = (): void => {
      const selectedCategories = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
          .map((input) => input.value),
      );
      const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('[name="publisher"]')?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
        const visible = categoryMatches && publisherMatches;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      filteredEmptyState.classList.toggle('hidden', visibleCount > 0);
      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    filterForm.addEventListener('change', applyFilters);
    filterForm.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  }
</script>
